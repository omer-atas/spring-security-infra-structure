    {
      "name": "6. Webhook",
      "description": "HMAC-SHA256 imzalı webhook olayı gönderimi.",
      "item": [
        {
          "name": "Olay Gönder (İmzalı)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Math.floor(Date.now() / 1000);",
                  "const raw = pm.request.body.raw;",
                  "const signingSecret = pm.collectionVariables.get('webhookSigningSecret');",
                  "const signature = 'sha256=' + CryptoJS.HmacSHA256(timestamp + '.' + raw, signingSecret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('webhookTimestamp', String(timestamp));",
                  "pm.collectionVariables.set('webhookSignature', signature);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Webhook-Key", "value": "demo-webhook" },
              { "key": "X-Webhook-Secret", "value": "webhook-secret" },
              { "key": "X-Webhook-Timestamp", "value": "{{webhookTimestamp}}" },
              { "key": "X-Webhook-Signature", "value": "{{webhookSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"ORDER_SHIPPED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "events"]
            }
          }
        }
      ]
    },
    {
