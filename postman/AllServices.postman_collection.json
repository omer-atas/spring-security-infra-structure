          "name": "JWKS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/.well-known/jwks.json",
              "host": ["{{baseUrl}}"],
              "path": [".well-known", "jwks.json"]
            }
          }
        },
        {
          "name": "Actuator Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{managementUrl}}/actuator/health",
              "host": ["{{managementUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    }
  ],
